{
    "clients": {
        "default": "ollama",
        "temperature": 0.0,
        "ollama": {
            "url": "http://localhost:11434",
            "model": "rockn/Qwen2.5-Omni-7B-Q4_K_M:latest"
        },
        "openai_api": {
            "api_key": "",
            "model": "meta-llama/llama-3.2-11b-vision-instruct",
            "api_url": "https://openrouter.ai/api/v1"
        },
        "qwen_omni": {
            "model": "Qwen/Qwen2.5-Omni-3B",
            "use_audio_in_video": true,
            "device_map": "auto",
            "use_flash_attention": false,
            "video_max_pixels": 401408,
            "fps": 3.0,
            "max_frames": 30
        },
        "scene_detection": {
            "threshold": 30.0,
            "min_scene_duration": 5.0,
            "max_scene_duration": 30.0,
            "sample_interval_seconds": 0.5
        }
    },
    "prompt_dir": "prompts",
    "prompts": [
        {
            "name": "Frame Analysis",
            "path": "frame_analysis/frame_analysis.txt"
        },
        {
            "name": "Video Reconstruction",
            "path": "frame_analysis/describe.txt"
        },
        {
            "name": "Qwen System Prompt",
            "path": "qwen_omni/system_prompt.txt"
        },
        {
            "name": "Qwen Analysis",
            "path": "qwen_omni/analysis.txt"
        },
        {
            "name": "Qwen Chunk Analysis",
            "path": "qwen_omni/chunk_analysis.txt"
        },
        {
            "name": "Qwen Verdict",
            "path": "qwen_omni/verdict.txt"
        },
        {
            "name": "Qwen Timestamp Extraction",
            "path": "qwen_omni/timestamp_extraction.txt"
        }
    ],
    "output_dir": "../output",
    "frames": {
        "per_minute": 600,
        "analysis_threshold": 10.0,
        "min_difference": 5.0,
        "max_count": 18000,
        "start_stage": 1,
        "max_frames": 18000
    },
    "response_length": {
        "frame": 300,
        "reconstruction": 1000,
        "narrative": 500
    },
    "audio": {
        "whisper_model": "medium",
        "sample_rate": 16000,
        "channels": 1,
        "quality_threshold": 0.2,
        "chunk_length": 30,
        "language_confidence_threshold": 0.8,
        "language": "en",
        "device": "cpu"
    },
    "keep_frames": false,
    "prompt": ""
}